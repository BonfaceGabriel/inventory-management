# Database Configuration
DATABASE_NAME=payment_production
DATABASE_USER=payment_user
DATABASE_PASSWORD=CHANGE_THIS_SECURE_PASSWORD

# Django Settings
SECRET_KEY=CHANGE_THIS_TO_RANDOM_50_CHAR_STRING
DEBUG=False
ALLOWED_HOSTS=api.yourdomain.com,yourdomain.com

# CORS Settings
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email (optional - for notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password