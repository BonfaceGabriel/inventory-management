# ============================================================
# Dokploy Deployment Environment Configuration
# Copy this to .env and update values for your Dokploy instance
# ============================================================

# Django Configuration
SECRET_KEY=your-generated-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-app-name.dokploy.com,your-custom-domain.com

# Database Configuration (Dokploy PostgreSQL)
DATABASE_HOST=dokploy-postgres-host  # Or your Postgres service name
DATABASE_NAME=inventory
DATABASE_USER=your-db-user
DATABASE_PASSWORD=your-db-password
DATABASE_PORT=5432

# ============================================================
# REDIS CONFIGURATION
# Each branch has its OWN Redis, using separate DBs internally:
#   DB 0: Celery broker (task queue)
#   DB 1: Celery result backend
#   DB 2: Django Channels (WebSocket layer)
# ============================================================

# Option 1: Self-hosted Redis Container (same dokploy network)
# REDIS_URL=redis://redis:6379/2
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1

# Option 2: Upstash Redis (Serverless, TLS enabled)
# Note: Upstash free tier only provides DB 0 — you'd need separate
# Redis instances for separate deployments or use a paid tier.
# REDIS_URL=rediss://default:your-password@your-host.upstash.io:6379
# CELERY_BROKER_URL=rediss://default:your-password@your-host.upstash.io:6379/0
# CELERY_RESULT_BACKEND=rediss://default:your-password@your-host.upstash.io:6379/0

# Option 3: Dokploy Internal Redis Service
# REDIS_URL=redis://dokploy-redis:6379/2
# CELERY_BROKER_URL=redis://dokploy-redis:6379/0
# CELERY_RESULT_BACKEND=redis://dokploy-redis:6379/1

# Option 4: Redis Cloud / Other hosted Redis
# REDIS_URL=redis://username:password@host:6379/2
# CELERY_BROKER_URL=redis://username:password@host:6379/0
# CELERY_RESULT_BACKEND=redis://username:password@host:6379/1

# ⚠ IMPORTANT: If multiple instances MUST share the same Redis server,
# assign each instance an offset of 3 (e.g., Main Shop: 0/1/2,
# Kitengela: 3/4/5), NOT sequential single DBs. Failure to do so
# causes cross-instance task contamination and WebSocket leaks.

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://your-app-name.dokploy.com,https://your-custom-domain.com

# Logging
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
