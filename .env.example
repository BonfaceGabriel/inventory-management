# Django Configuration
SECRET_KEY=your-secret-key-here-generate-new-one-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database configuration
DATABASE_HOST=db
DATABASE_NAME=inventory
DATABASE_USER=gabriel
DATABASE_PASSWORD=your-secure-password-here
DATABASE_PORT=5432

# Celery & Redis
# Separate Redis DBs to isolate concerns:
#   DB 0: Celery broker (task queue)
#   DB 1: Celery result backend
#   DB 2: Django Channels (WebSocket layer)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_URL=redis://redis:6379/2
CONVERSATION_MEMORY_REDIS_URL=redis://redis:6379/3

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com

# Logging
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# Multi-Branch Payment Relay
# Primary instance sends payment SMS from shared tills to all target branches.
PAYMENT_RELAY_SECRET=
# Targets as JSON array: [{"name":"Kitengela","url":"https://kitengela-api.eagleshop.cloud"}]
PAYMENT_RELAY_TARGETS=[]
# Comma-separated gateway types to relay (only shared till types)
PAYMENT_RELAY_GATEWAY_TYPES=MPESA_TILL,MERCHANDISE
# Branch name for identifying the source of relayed messages
BRANCH_NAME=Main Shop

# Inventory API (shared token with BF SUMA Eagleshop website)
VITE_INVENTORY_API_KEY=

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# Comma-separated Telegram user IDs allowed to use the bot
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
# Chat ID for sending automated daily reports
TELEGRAM_CHAT_ID=123456789

# LLM Configuration (for free-form BI questions)
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# LLM Provider Selection (defaults to openai)
# Options: "openai", "groq", or "gemini"
LLM_PROVIDER=openai

# Groq Configuration (free, OpenAI-compatible)
# https://console.groq.com — sign up for a free API key
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama3-8b-8192

# Gemini Configuration (free, best free option for tool calling)
# Uses Gemini's OpenAI-compatible endpoint at generativelanguage.googleapis.com/v1beta/openai/
# https://aistudio.google.com/apikey — get a free API key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
